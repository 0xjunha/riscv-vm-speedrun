# Required project settings.
GCP_PROJECT=your-project-id

# Use "official" profile for reproducible runs with the pinned host settings.
# Use "authoring" for experiments.
GCP_BENCHMARK_PROFILE=official
GCP_ZONE=asia-northeast3-a
GCP_NETWORK=default
GCP_SUBNET=default
GCP_NETWORK_TAGS=

# Official runs require these exact machine and OS image settings. GCP_IMAGE pins the image.
GCP_MACHINE_TYPE=c3-highcpu-4
GCP_IMAGE_PROJECT=ubuntu-os-cloud
GCP_IMAGE=ubuntu-2404-noble-amd64-v20260723
GCP_INSTANCE_PREFIX=rv32im-bench
GCP_USE_IAP=0

# Harness settings shared by VM0 through VM5 and the native reference.
BENCHMARK_WARMUPS=2
BENCHMARK_REPETITIONS=7
BENCHMARK_TIMEOUT_SECONDS=30
