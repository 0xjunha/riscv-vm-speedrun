# Required project settings.
GCP_PROJECT=your-project-id
GCP_ZONE=asia-northeast3-a
GCP_NETWORK=default
GCP_SUBNET=default
GCP_NETWORK_TAGS=

# Keep these stable when comparing benchmark runs.
GCP_MACHINE_TYPE=c3-highcpu-4
GCP_IMAGE_PROJECT=ubuntu-os-cloud
GCP_IMAGE_FAMILY=ubuntu-2404-lts-amd64
GCP_INSTANCE_PREFIX=rv32im-bench
GCP_USE_IAP=0

# Harness settings shared by VM0 through VM5 and the native reference.
BENCHMARK_WARMUPS=2
BENCHMARK_REPETITIONS=7
BENCHMARK_TIMEOUT_SECONDS=10
