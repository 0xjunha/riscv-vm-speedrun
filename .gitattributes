# Preserve exact upstream bytes while keeping specification sources reviewable.
third_party/riscv/isa_specs/** -text
third_party/riscv/isa_specs/README.md text eol=lf

# Conformance snapshots are sealed upstream inputs; suppress noisy bulk diffs.
third_party/riscv/conformance/upstream/** -text -diff

# Treat imported executable artifacts as binary data.
third_party/riscv/**/*.elf -text -diff
third_party/riscv/**/*.bin -text -diff

# Collapse reproducible generated outputs in GitHub diffs.
conformance/artifacts/** linguist-generated=true
contracts/artifacts/** linguist-generated=true
benchmarks/artifacts/** linguist-generated=true
benchmarks/long_artifacts/** linguist-generated=true

# Treat generated benchmark inputs and executables as binary data.
benchmarks/artifacts/elf/** -text -diff
benchmarks/artifacts/input/** -text -diff
benchmarks/long_artifacts/elf/** -text -diff
benchmarks/long_artifacts/input/** -text -diff

# Keep project-owned import tooling and provenance metadata portable.
.gitattributes text eol=lf
scripts/*.sh text eol=lf
third_party/riscv/manifests/** text eol=lf
third_party/riscv/THIRD_PARTY_NOTICES.md text eol=lf

# Preserve vendored littlefs whitespace.
benchmarks/guest/licenses/littlefs-BSD-3-Clause.txt whitespace=-trailing-space
benchmarks/third_party/littlefs/lfs.c whitespace=-trailing-space,-blank-at-eof
benchmarks/third_party/littlefs/lfs.h whitespace=-trailing-space
